<resources>
    <!--
      Post-splash window theme. Colors at runtime come from the Compose `FilmatubeTheme`;
      this only sets the window chrome (forced-dark green background, transparent system bars
      for edge-to-edge).
    -->
    <style name="Theme.Filmatube" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/filmatube_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Launch theme using the AndroidX SplashScreen API. Shows the Filmatube mark on a
      dark green background, then hands off to Theme.Filmatube. (The richer animated splash
      is Day 15.)
    -->
    <style name="Theme.Filmatube.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/filmatube_background</item>
        <!--
          No icon here on purpose — the app shows exactly one logo, the animated one on the
          in-app splash. Android 12+ always draws a system splash before the Activity exists
          and it can't be disabled, so the only way to avoid showing the mark twice is to draw
          nothing over a matching background and let the animated splash carry it.

          (This slot used to point at @drawable/ic_launcher_foreground — a stale hand-drawn
          vector that shared its name with the real brand mark in @mipmap. The launcher icon
          referenced the mipmap, so a brand refresh updated the app icon and left this behind:
          that's why the first splash didn't match.)
        -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="postSplashScreenTheme">@style/Theme.Filmatube</item>
    </style>
</resources>
