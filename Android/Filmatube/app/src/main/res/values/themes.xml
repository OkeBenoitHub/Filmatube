<resources>
    <!--
      Post-splash window theme. Colors at runtime come from the Compose `FilmatubeTheme`;
      this only sets the window chrome (forced-dark green background, transparent system bars
      for edge-to-edge).
    -->
    <style name="Theme.Filmatube" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/filmatube_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Launch theme using the AndroidX SplashScreen API. Shows the Filmatube mark on a
      dark green background, then hands off to Theme.Filmatube. (The richer animated splash
      is Day 15.)
    -->
    <style name="Theme.Filmatube.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/filmatube_background</item>
        <!--
          @mipmap, not @drawable. Two files share the name ic_launcher_foreground: a stale
          hand-drawn vector that used to live in res/drawable, and the real brand mark in
          res/mipmap. The launcher icon referenced the mipmap, so a brand refresh updated the
          app icon and left this slot showing the old mark — that's why the first splash
          didn't match. Both now point at the same asset and can't drift apart again.

          Android 12+ always draws this splash before the Activity exists and it can't be
          disabled, so the aim is continuity rather than removal: same mark, same #0E1512
          background, and the system renders it at roughly the 104dp the animated splash uses,
          so the logo appears to stay put while the animation takes over.
        -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Filmatube</item>
    </style>
</resources>
